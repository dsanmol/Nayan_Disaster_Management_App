# Generate a unique, random value before running outside a local demo.
NAYAN_JWT_SECRET=replace-with-a-long-random-secret
# Optional PostgreSQL connection. SQLite is used when omitted.
# DATABASE_URL=postgresql+psycopg://nayan:password@localhost:5432/nayan
# Optional private OSRM service base URL. Unset means route previews use a straight-line estimate.
# NAYAN_ROUTING_URL=http://localhost:5000
